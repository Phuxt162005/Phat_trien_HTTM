.env
.env.*
!.env.example
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
data/documents/**
!data/documents/**/.gitkeep
data/raw/**
!data/raw/**/.gitkeep
data/processed/**
!data/processed/.gitkeep
data/vector_store/**

# Keep model artifacts local by default; allow selected small artifacts only.
models/**
!models/.gitkeep
!models/ml_experiment_summary.json
!models/diabetes01/
!models/diabetes04/

# diabetes01: share metrics and deployable small models; keep Random Forest local.
models/diabetes01/*
!models/diabetes01/metrics.json
!models/diabetes01/logistic_regression.joblib
!models/diabetes01/deep_learning_mlp.pt
!models/diabetes01/deep_learning_preprocessor.joblib

# diabetes04: share metrics and deployable small models; keep Random Forest local.
models/diabetes04/*
!models/diabetes04/metrics.json
!models/diabetes04/logistic_regression.joblib
!models/diabetes04/deep_learning_mlp.pt
!models/diabetes04/deep_learning_preprocessor.joblib

# Share experiment reports; keep large model artifacts local.
!models/diabetes04/feature_diagnostics.json
!models/diabetes04/imbalance_comparison.json
!models/diabetes04/minority_threshold_tuning.json
!models/diabetes04/model_benchmark.json
!models/diabetes04/classwise_probability_tuning.json

logs/**
!logs/.gitkeep
*.log
