models/diabetes01/*
!models/diabetes01/metrics.json
!models/diabetes01/logistic_regression.joblib
!models/diabetes01/deep_learning_mlp.pt
!models/diabetes01/deep_learning_preprocessor.joblib

# diabetes04: share metrics and deployable small models; keep Random Forest local.
