# Copy this file to .env and fill values locally. Never commit .env.
PROJECT01_ENV=development
PROJECT01_DATA_DIR=data/raw
PROJECT01_ARTIFACT_DIR=models

# Neo4j Aura / Desktop
NEO4J_URI=neo4j+s://<your-instance>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Optional LLM provider configuration (choose provider in later integration)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
