# Copy this file to .env and fill values locally. Never commit .env.
PROJECT01_ENV=development
PROJECT01_DATA_DIR=data/raw
PROJECT01_ARTIFACT_DIR=models

# Neo4j Aura / Desktop (use credentials from your own instance)
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Optional LLM provider. Leave LLM_PROVIDER empty to disable generation.
# Ollama: install/run Ollama locally, pull a chat model, then set provider/model.
LLM_PROVIDER=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=

# OpenAI or another OpenAI-compatible service:
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# Optional generation controls
LLM_TIMEOUT_SECONDS=45
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900
